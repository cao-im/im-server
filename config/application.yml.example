# 曹操IM Server 配置文件
# 复制此文件到 config/application.yml 并根据实际情况修改
#
# 【端口配置】
# ✅ 端口已开放，可以自由配置！默认端口为 8080
#
# 【修改端口的方法（3种）】
# 方式1：修改下方 server.port 的值（推荐）
# 方式2：启动参数 --server.port=xxxx
# 方式3：环境变量 SERVER_PORT=xxxx
#
# 【注意事项】
# - 修改IM服务端口后，必须同步更新 app-server 的配置
# - 确保所选端口未被其他程序占用
# - 生产环境记得在防火墙中放行相应端口
#
# 【推荐的端口】
# - 开发环境：8080, 8888, 9000
# - 生产环境：8080, 8081, 8082 或根据公司规范

server:
  # IM服务监听端口（可自由修改）
  port: 8080
  servlet:
    context-path: /api

spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    # 修改为您的数据库地址
    url: jdbc:mysql://localhost:3306/cao_im_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: your_password_here  # ← 修改密码

  data:
    redis:
      host: localhost
      port: 6379
      password:  # Redis 密码（如果有）
      database: 0
      lettuce:
        pool:
          max-active: 8
          max-idle: 8
          min-idle: 0
          max-wait: -1ms

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0
  mapper-locations: classpath*:/mapper/**/*.xml

jwt:
  secret: your-production-secret-key-must-be-very-long-and-secure  # ← 修改密钥
  expiration: 86400000  # Token 有效期（毫秒），默认24小时

springdoc:
  api-docs:
    path: /api-docs
  swagger-ui:
    path: /swagger-ui/index.html  # SpringDoc 2.x 标准路径
    enabled: false  # 生产环境建议关闭 Swagger（开发环境改为 true）
